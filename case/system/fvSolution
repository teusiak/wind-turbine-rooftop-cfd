SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent yes;
    pRefPoint       (-50 -50 50); // A point high in the air, away from objects
    pRefValue       0;
    residualControl
    {
        p           1e-3;
        U           1e-4;
        k           1e-4;
        omega       1e-4;
    }
}

relativeConvergence
{
    p           0.05;
    U           0.05;
    k           0.05;
    omega       0.05;
}

relaxationFactors
{
    fields
    {
        p               0.2;
    }
    equations
    {
        U               0.3;
        k               0.5;
        omega           0.5;
    }
}
